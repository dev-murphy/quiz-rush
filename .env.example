# The single Game Master account. Change these before hosting the event.
GAME_MASTER_USERNAME=admin
GAME_MASTER_PASSWORD=change-me-tonight

# Optional: where the SQLite database file is written (defaults to ./data/game.db)
# DB_PATH=./data/game.db

# Optional: S3-compatible object storage (e.g. RustFS) for pin-answer question images.
# Uploads are disabled (URL entry only) until all four of these are set.
# RUSTFS_ENDPOINT=https://rustfs.example.com
# RUSTFS_BUCKET=quiz-rush
# RUSTFS_ACCESS_KEY_ID=
# RUSTFS_SECRET_ACCESS_KEY=
# RUSTFS_REGION=us-east-1
# RUSTFS_FORCE_PATH_STYLE=true
# Base URL images are served from; defaults to "<RUSTFS_ENDPOINT>/<RUSTFS_BUCKET>"
# RUSTFS_PUBLIC_URL=
